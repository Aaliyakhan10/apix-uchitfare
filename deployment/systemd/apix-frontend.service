[Unit]
Description=APIx UchitFare Next.js Frontend Dashboard Service
After=network.target apix-backend.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/sih26/apix-dashboard
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="NODE_ENV=production"
Environment="PORT=3001"
Environment="NEXT_PUBLIC_API_URL=http://127.0.0.1:8001"
ExecStart=/usr/bin/npm run start -- -p 3001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
