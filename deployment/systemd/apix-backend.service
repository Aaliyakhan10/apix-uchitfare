[Unit]
Description=APIx UchitFare FastAPI Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/sih26
Environment="PATH=/opt/sih26/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=8001"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/sih26/venv/bin/uvicorn apix_demo.backend.main:app --host 0.0.0.0 --port 8001 --workers 4
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
