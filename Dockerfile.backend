# ==============================================================================
# APIx UchitFare - Backend Container (FastAPI + ML Engine + TimeSeries DB)
# ==============================================================================
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8001

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

COPY apix_demo /app/apix_demo
COPY run_demo.py /app/

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/api/database/stats || exit 1

CMD ["uvicorn", "apix_demo.backend.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "4"]
